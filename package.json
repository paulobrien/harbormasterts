{
  "name": "harbor-master-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview",
    "build": "npm run typecheck && vite build && node tools/copy-public.mjs && node tools/version-shell.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "node tools/run-tests.mjs",
    "test:e2e": "playwright test",
    "stage:assets": "node tools/stage-assets.mjs",
    "build:playable": "npm run build && npm run stage:assets && node tools/include-game-bundle.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
